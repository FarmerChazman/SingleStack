{
  "name": "singlestack-inbound-mail",
  "private": true,
  "type": "module",
  "description": "Cloudflare Email Worker that relays inbound mail to Chatwoot's Action Mailbox relay ingress",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.163.0"
  }
}
