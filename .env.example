# singlestack configuration.
#   make init DOMAIN=example.com   -> copies this to .env, fills every __GENERATE__
#                                     with a random secret and swaps example.com.
# Then fill the remaining blanks (Brevo SMTP key) and run `make preflight`.
#
# Plain KEY=value lines only: scripts parse this file without executing it.

# ── stack ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=singlestack
TZ=Australia/Perth
DOMAIN=example.com
SUPPORT_HOST=support.example.com
LISTS_HOST=lists.example.com

# Docker network shared with your existing reverse proxy (nginx / cloudflared).
EDGE_NETWORK=edge

# Host loopback binds for health checks and SSH-tunnel admin.
# Taken on the farm-analyser host: 5173 8000 8088 8090 9000 9001.
CHATWOOT_BIND=127.0.0.1:3001
LISTMONK_BIND=127.0.0.1:3002

# ── images (pinned; bump deliberately, then `make upgrade`) ────────────────
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.19.1
LISTMONK_IMAGE=listmonk/listmonk:v6.2.0

# ── postgres (one instance, one database + role per app) ───────────────────
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
CHATWOOT_DB_PASSWORD=__GENERATE__
LISTMONK_DB_PASSWORD=__GENERATE__

# ── redis (chatwoot only) ──────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE__

# ── chatwoot ───────────────────────────────────────────────────────────────
CHATWOOT_SECRET_KEY_BASE=__GENERATE__
CHATWOOT_ENABLE_SIGNUP=false
CHATWOOT_LOG_LEVEL=info
# From: on system mail (password resets, notifications). Domain must be verified in Brevo.
CHATWOOT_MAILER_SENDER=Support <support@example.com>
# Reply-to domain for conversation continuity (reply+<uuid>@...).
# Needs its own Cloudflare Email Routing catch-all -> inbound-mail worker.
CHATWOOT_INBOUND_DOMAIN=in.example.com
# Shared secret between the Cloudflare worker and Chatwoot's relay ingress.
CHATWOOT_INBOUND_PASSWORD=__GENERATE__

# ── brevo (all outbound mail) ──────────────────────────────────────────────
# Brevo > SMTP & API > SMTP. Create one SMTP key per consumer so each can be
# revoked on its own. Listmonk's key is entered in its UI (docs/operations.md).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
CHATWOOT_SMTP_USER=
CHATWOOT_SMTP_KEY=

# ── listmonk ───────────────────────────────────────────────────────────────
# Only applied on first boot; change later in the UI.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=__GENERATE__

# ── backups ────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
